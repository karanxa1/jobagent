# Copy to .env and fill in. Never commit .env.

# Main LLM key: only the one for your llm.provider (config.yaml). Azure without a key uses your `az login`.
# AZURE_OPENAI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=                # or GOOGLE_API_KEY
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=     # if your openai_compatible server wants one (ollama needs none)

# Cloudflare Workers AI (job triage + post-submit verification models). Optional: without these the main LLM
# makes those decisions (decider.provider: auto).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=            # token with the "Workers AI: Read" permission

# Password the agent uses when a job portal makes you create an account (Workday, Taleo, iCIMS...).
# Use a NEW password you use nowhere else: 18 chars with upper/lower case, digits and a symbol.
ATS_PASSWORD=
# Same mix but 16 characters, for portals that cap password length.
ATS_PASSWORD_SHORT=

# Gmail app password (Google Account -> Security -> 2-Step Verification -> App passwords).
# Lets the agent read verification codes (otp.provider: imap) and send email applications over SMTP.
GMAIL_APP_PASSWORD=
