# Copy to .env and fill in. Never commit .env.

# Cloudflare Workers AI (job triage + post-submit verification models)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=            # token with the "Workers AI: Read" permission

# Password the agent uses when a job portal makes you create an account (Workday, Taleo, iCIMS...).
# Use a NEW password you use nowhere else: 18 chars with upper/lower case, digits and a symbol.
ATS_PASSWORD=
# Same mix but 16 characters, for portals that cap password length.
ATS_PASSWORD_SHORT=

# Gmail app password (Google Account -> Security -> 2-Step Verification -> App passwords).
# Lets the agent read verification codes (otp.provider: imap) and send email applications over SMTP.
GMAIL_APP_PASSWORD=
